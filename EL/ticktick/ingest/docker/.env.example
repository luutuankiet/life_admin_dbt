# Copy to .env (gitignored) and fill in. Placeholders only: never commit real values.

# TickTick web session (cookie `t`, browser user agent, X-Device JSON header, timezone)
TICKTICK_COOKIE_T=<t cookie value>
TICKTICK_USER_AGENT=<browser user agent>
TICKTICK_X_DEVICE=<x-device json header>
TICKTICK_TIMEZONE=Asia/Ho_Chi_Minh

# TickTick pushes change hints to one socket per device id, so the `id` field of
# TICKTICK_X_DEVICE is replaced: by default with an id derived from the compose project
# name (each stack gets its own), or with this value when set (24 lowercase hex). Set it
# only when two stacks on different hosts share a project name.
# TICKTICK_DEVICE_ID=

# Listener: reconnect when no frame has arrived for this many minutes (0 = never). The
# socket is silent between changes, so each reconnect on a quiet account costs one
# empty fetch.
INGEST_LISTENER_IDLE_MINUTES=60

# BigQuery destination
TICKTICK_INGEST_DATASET=ticktick_ingest
DBT_BQ_PROJECT=<gcp project id>
DBT_BQ_LOCATION=<bigquery location>
# Inside the containers; compose mounts ./secrets/sa.json there.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json

# Failure alerts: full ntfy topic URL
NTFY_URL=<https://ntfy.example/topic>

# Shared state volume (hint file, gate cache, dlt and Dagster storage)
INGEST_STATE_DIR=/state

# Where the Dagster UI is published on the host (tailnet address, not public)
DAGSTER_WEB_BIND=127.0.0.1
DAGSTER_WEB_PORT=3070
