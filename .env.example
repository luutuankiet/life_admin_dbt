# Copy to .env (gitignored) and fill in. Full list: docs/reference/configuration.md

# dbt / BigQuery
DBT_TARGET=dev
DBT_BQ_PROJECT=
DBT_BQ_LOCATION=
DBT_BQ_KEYFILE=./sa.json
# DBT_DEV_DATASET=ticktick_dbt_dev
# DBT_PROD_DATASET=ticktick_dbt_prod
DBT_TIMEZONE=UTC
DBT_LOAD_INTERVAL=15

# GCS (external tables; HMAC pair only for the legacy DuckDB targets)
GCS_RAW_BUCKET=
GCS_KEY=
GCS_SECRET=
# GCS_REGION=auto

# GTD work-type categorization
ENABLE_GTD_WORK_TYPE_CATEGORIZATION=true
GTD_DEEP_WORK_TAGS='["clarified"]'
GTD_SHALLOW_WORK_TAGS='[]'

# Grafana exporter
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Legacy Lightdash exposures
# DBT_OWNER_EMAIL=
# LIGHTDASH_URL=
